	@test -d $(INSTALL_ROOT)/opt/ExSkeletonRobot/bin || mkdir -p $(INSTALL_ROOT)/opt/ExSkeletonRobot/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/ExSkeletonRobot/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/ExSkeletonRobot/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ExSkeletonRobot/bin/ 


